# Copy to .env and fill in. Never commit .env. Names only here — no real values.

# Geoapify: places, routing, geocoding (used by the server only). Free plan, no card: https://myprojects.geoapify.com/
# Required when NODE_ENV=production.
GEOAPIFY_API_KEY=

# Optional
# Contact details sent to Wikipedia/Wikidata in the User-Agent (an email address or URL). Wikimedia
# rate-limits anonymous clients more strictly; with this set, place descriptions fail less often.
# WIKIMEDIA_CONTACT=
PORT=3000
NODE_ENV=development
# MongoDB connection (defaults to a local MongoDB). A free MongoDB Atlas cluster also works: mongodb+srv://...
# MONGODB_URI=mongodb://127.0.0.1:27017/wanderwish
# Extra origins allowed to call the API cross-origin (comma-separated). Normally leave empty.
# ALLOWED_ORIGINS=
# Backups (npm run backup / npm run share)
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
